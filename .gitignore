# This folder is the working copy of the shared repository.
# Allow-list: everything is ignored unless listed below, so private material
# (scraped adverts, papers, superseded work, large inputs) can never be committed.
/*
!/.gitignore
!/README.md
!/get_data.py
!/docs/

!/analysis/
/analysis/*
!/analysis/routing.ipynb
!/analysis/socioeconomic_eda.ipynb
!/analysis/accessibility_analysis.ipynb
!/analysis/access_maps.ipynb

!/analysis/Data/
/analysis/Data/*
!/analysis/Data/KINDERGARTENOGD.json
!/analysis/Data/BEZIRKSGRENZEOGD.json
!/analysis/Data/socioeconomic/
/analysis/Data/socioeconomic/*
!/analysis/Data/socioeconomic/scripts/
!/analysis/Data/socioeconomic/processed/
/analysis/Data/socioeconomic/processed/willhaben_listings_clean.gpkg
!/analysis/Data/socioeconomic/raw/
/analysis/Data/socioeconomic/raw/*
!/analysis/Data/socioeconomic/raw/ZAEHLBEZIRKOGD.json
!/analysis/Data/socioeconomic/raw/GEMBAUTENFLOGD.json
!/analysis/Data/socioeconomic/raw/zbz_pop_birthcountry_agegroups_since2008.csv
!/analysis/Data/socioeconomic/raw/zbz_births_since2015.csv
!/analysis/Data/socioeconomic/raw/bez_education_since2008.csv
!/analysis/Data/socioeconomic/raw/bez_income_since2011.csv
!/analysis/Data/socioeconomic/raw/statistik_zsp_boundaries_2026/
!/analysis/Data/socioeconomic/raw/statistik_inspire/
/analysis/Data/socioeconomic/raw/statistik_inspire/*
